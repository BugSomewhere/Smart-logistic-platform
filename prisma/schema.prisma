// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  warehouse_manager
  dispatcher
  driver
}

// ─── USER ─────────────────────────────────────────
model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password_hash String
  full_name     String
  role          Role        @default(driver)
  refresh_token String?
  created_at    DateTime    @default(now())
  orders        Order[]
  driver        Driver?
  route_stops   RouteStop[]

  @@map("users")
}

// ─── CATEGORY ─────────────────────────────────────────
model Category {
  id         String    @id @default(uuid())
  name       String    @unique
  products   Product[]
  created_at DateTime  @default(now())

  @@map("categories")
}

// ─── PRODUCT ─────────────────────────────────────────
model Product {
  id          String    @id @default(uuid())
  sku         String    @unique
  name        String
  category_id String
  unit        String
  price       Decimal   @db.Decimal(12, 2)
  created_at  DateTime  @default(now())
  deletedAt   DateTime?

  Category        Category        @relation(fields: [category_id], references: [id])
  order_items     OrderItem[]
  stock_movements StockMovement[]
  inventories     Inventory[]
  forecasts       Forecast[]

  @@map("products")
}

// ─── WAREHOUSE ─────────────────────────────────────────
model Warehouse {
  id        String  @id @default(uuid())
  name      String  @unique
  address   String
  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  stock_movements StockMovement[]
  inventories     Inventory[]
  orders          Order[]
  forecasts       Forecast[]

  @@map("warehouses")
}

// ─── INVENTORY (tồn kho per product+warehouse) ──────
model Inventory {
  id                  String    @id @default(uuid())
  product_id          String
  warehouse_id        String
  quantity            Int       @default(0)
  low_stock_threshold Int       @default(10)
  product             Product   @relation(fields: [product_id], references: [id])
  warehouse           Warehouse @relation(fields: [warehouse_id], references: [id])

  @@unique([product_id, warehouse_id])
  @@map("inventories")
}

// ─── STOCK MOVEMENT ──────────
enum MovementType {
  in
  out
}

model StockMovement {
  id                 String       @id @default(uuid())
  product_id         String
  warehouse_id       String
  type               MovementType
  quantity           Int
  reference_order_id String?
  created_at         DateTime     @default(now())

  product   Product   @relation(fields: [product_id], references: [id])
  warehouse Warehouse @relation(fields: [warehouse_id], references: [id])
  order     Order?    @relation(fields: [reference_order_id], references: [id])

  @@map("stock_movements")
}

// ─── ORDER ─────────────────────────────────────────
enum OrderStatus {
  pending
  confirmed
  shipping
  delivered
  failed
  cancelled
}

model Order {
  id           String      @id @default(uuid())
  status       OrderStatus @default(pending)
  total_amount Decimal     @default(0) @db.Decimal(12, 2)
  warehouse_id String
  created_by   String
  planned_date DateTime?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  creator         User            @relation(fields: [created_by], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouse_id], references: [id])
  items           OrderItem[]
  delivery_points DeliveryPoint[]
  stock_movements StockMovement[]

  @@map("orders")
}

// ─── ORDER ITEM ──────────────────────────────────────
model OrderItem {
  id         String  @id @default(uuid())
  order_id   String
  product_id String
  quantity   Int
  unit_price Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

// ─── DELIVERY POINT ──────────────────────────────
model DeliveryPoint {
  id                String  @id @default(uuid())
  order_id          String
  address           String
  latitude          Decimal @db.Decimal(10, 7)
  longitude         Decimal @db.Decimal(10, 7)
  time_window_start String?
  time_window_end   String?

  order      Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  route_stops RouteStop[]

  @@map("delivery_points")
}

// ─── DRIVER ─────────────────────────────────────────
enum DriverStatus {
  available
  on_route
  off_duty
}

model Driver {
  id      String       @id @default(uuid())
  user_id String       @unique
  phone   String
  status  DriverStatus @default(available)
  user    User         @relation(fields: [user_id], references: [id])
  routes  Route[]
  locations DriverLocation[]
  @@map("drivers")
}

// ─── VEHICLE ─────────────────────────────────────────
model Vehicle {
  id           String  @id @default(uuid())
  plate_number String  @unique
  capacity     Decimal @db.Decimal(10, 2)
  type         String
  routes       Route[]

  @@map("vehicles")
}

// ─── ROUTE ───────────────────────────────────────────
enum RouteStatus {
  planned
  in_progress
  completed
}

model Route {
  id                 String      @id @default(uuid())
  route_date         DateTime    @db.Date
  driver_id          String?
  vehicle_id         String?
  status             RouteStatus @default(planned)
  total_distance_km  Decimal?    @db.Decimal(10, 2)
  total_duration_min Decimal?    @db.Decimal(10, 2)
  created_at         DateTime    @default(now())
  driver             Driver?     @relation(fields: [driver_id], references: [id])
  vehicle            Vehicle?    @relation(fields: [vehicle_id], references: [id])
  stops              RouteStop[]
  locations          DriverLocation[]
  @@map("routes")
}

// ─── ROUTE STOP ──────────────────────────────────────
enum RouteStopStatus {
  pending
  arrived
  completed
  failed
}

model RouteStop {
  id                String          @id @default(uuid())
  route_id          String
  delivery_point_id String
  sequence          Int
  eta               DateTime?
  status            RouteStopStatus @default(pending)
  route             Route           @relation(fields: [route_id], references: [id], onDelete: Cascade)
  delivery_point    DeliveryPoint   @relation(fields: [delivery_point_id], references: [id])
  user              User?           @relation(fields: [userId], references: [id])
  userId            String?

  @@map("route_stops")
}

// ─── FORECAST ────────────────────────────────────────
model Forecast {
  id                  String    @id @default(uuid())
  product_id          String
  warehouse_id        String?
  forecast_date       DateTime  @db.Date
  predicted_quantity  Decimal   @db.Decimal(12, 2)
  actual_quantity     Decimal?  @db.Decimal(12, 2)
  model_used          String
  created_at          DateTime  @default(now())

  product    Product    @relation(fields: [product_id], references: [id])
  warehouse  Warehouse? @relation(fields: [warehouse_id], references: [id])

  @@map("forecasts")
}

// ─── DRIVER LOCATION (lịch sử vị trí tài xế) ────────
model DriverLocation {
  id         String   @id @default(uuid())
  driver_id  String
  route_id   String?
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  recorded_at DateTime @default(now())

  driver Driver @relation(fields: [driver_id], references: [id])
  route  Route?  @relation(fields: [route_id], references: [id])

  @@map("driver_locations")
}


